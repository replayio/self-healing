# Server-side only. Use separate database branches and keys for deploy previews.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
# JSON object: random bearer key (32+ characters) -> stable account ID.
# Generate keys with: openssl rand -hex 32
# Account IDs isolate projects. Provision/rotate keys out of band for this scaffold.
SELF_HEALING_API_KEYS={"replace-with-a-random-key-at-least-32-characters":"example-account"}
