# Server-side infrastructure configuration; use isolated databases for previews.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
# CI only, fetched from Infisical. Do not copy these into Netlify functions.
NETLIFY_AUTH_TOKEN=
NETLIFY_ACCOUNT_SLUG=replay
NETLIFY_SITE_ID=48d9b72b-7125-484b-8082-1021cbc84456
# Factories send their own Subtext key in Authorization: Bearer <key>.
# No shared Subtext credential or Self Healing key map belongs in this deployment.
# Runtime: generate once with `openssl rand -base64 32`; back it up, never casually rotate.
# Used for key fingerprints, encrypted retained credentials, and QA gateway capabilities.
SELF_HEALING_SECRET=
# Runtime: private QA service account API token; customer keys never go to QA.
REPLAY_QA_API_TOKEN=
REPLAY_QA_URL=https://qa.replay.io
